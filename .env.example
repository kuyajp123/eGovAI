# Application Configuration
VITE_APP_BASE_URL=https://govassistant.example.com

# eGovPH SSO Configuration
VITE_EGOV_SSO_URL=https://platforms-api.e.gov.ph/egov-sso
VITE_API_BASE_URL=https://platforms-api.e.gov.ph/egov-sso/api/partner/sso_authentication

# eGovPH Partner Credentials
VITE_EGOV_PARTNER_CODE=a101db722afd40a2b33d39ed14b274e5
VITE_EGOV_PARTNER_SECRET=your_partner_secret_here

# Face Liveness API Configuration
# Proxy path: /face-liveness-api -> https://platforms-api.e.gov.ph/face-liveness
VITE_FACE_LIVENESS_BASE_URL=https://platforms-api.e.gov.ph/face-liveness
VITE_FACE_LIVENESS_URL=/face-liveness-api
VITE_FACE_LIVENESS_API_KEY=your_face_liveness_api_key

# eVerify API Configuration
VITE_EVERIFY_BASE_URL=https://platforms-api.e.gov.ph/everify
VITE_EVERIFY_CLIENT_ID=2339c46bf9664aa3b1c8527d22feeadd
VITE_EVERIFY_CLIENT_SECRET=your_everify_client_secret_here
VITE_EVERIFY_PUBKEY=eyJpdiI6InAzOGc3d1BZcVVZck1IY3plS0xscVE9PSIsInZhbHVlIjoiSlRESmdFYkZ4ZnV3M1ZkUjFiTHpDUT09IiwibWFjIjoiZTEzZjI5ZGRkZTVhNWNkNGU3ZmQ0NDY4MTAyZDY2Yjc1NjJiYmMxNTMwN2E2NzVlZmM5ZjhjZmEyZWM1ZmMwMCIsInRhZyI6IiJ9

# eGovPH AI Integration API
VITE_EGOV_INTEGRATION_BASE_URL=https://egov-ai-core-ws.oueg.info
VITE_EGOV_ACCESS_CODE=your_access_code_here

# eGovPay Development Gateway
VITE_EGOVPAY_API_KEY=test_your_egovpay_api_key_here
VITE_EGOVPAY_SETTLEMENT_UUID=your_settlement_template_uuid_here
# Recipient-specific donation settlements. Campaigns without their own UUID are disabled.
# This must be a single-line JSON array. Example:
# VITE_DONATION_CAMPAIGNS_JSON=[{"id":"disaster-relief","title":"Disaster Relief","recipientName":"Verified Recipient","location":"Philippines","purpose":"Emergency relief","settlementTemplateUuid":"recipient_settlement_uuid","keywords":["disaster","relief","typhoon"],"suggestedAmounts":[100,500,1000],"active":true}]
VITE_DONATION_CAMPAIGNS_JSON=
# eGovChain anchoring is enabled by default. Set false for a local-only ledger.
VITE_ECHAIN_ANCHORING_ENABLED=true
# Optional client override. The default is the same-origin /api/echain Vercel Function.
VITE_ECHAIN_API_BASE=/api/echain

# eGovChain server-only configuration. NEVER prefix the private key with VITE_.
ECHAIN_RPC_URL=https://hackathon-blockchain.e.gov.ph
ECHAIN_EXPLORER_URL=https://hackathon-explorer.e.gov.ph
# Update this template if an explorer transaction uses a different route.
ECHAIN_EXPLORER_TX_URL_TEMPLATE=https://hackathon-explorer.e.gov.ph/tx/{txHash}
ECHAIN_CHAIN_ID=13371
ECHAIN_PRIVATE_KEY=
# A server-only copy is used to re-verify PAID/SUCCESS before anchoring.
EGOVPAY_API_KEY=test_your_egovpay_api_key_here
EGOVPAY_API_URL=https://egovpay-pgi-ws-dev.oueg.info
# Test-only fee used by SSS Member Record Verification. The gateway rejects zero-value transactions.
VITE_SSS_RECORD_VERIFICATION_FEE=1

# DBM Transparency Portal (Compass API)
# Base URL: https://dbm-ws.oueg.info — proxied through /compass-api
# Used for live SAAODB, NCA, SARO, and LGSF budget records.
VITE_COMPASS_API_KEY=your_compass_api_key_here

# Environment
NODE_ENV=production
