# Application Configuration
VITE_APP_BASE_URL=https://govassistant.example.com

# eGovPH Configuration
VITE_EGOV_SSO_URL=https://hackathon-sso.e.gov.ph
VITE_API_BASE_URL=https://govassistant.example.com/api

# eGovPH Partner Credentials (Hackathon)
VITE_EGOV_PARTNER_CODE=HACKATHON_SSO
VITE_EGOV_PARTNER_SECRET=your_partner_secret_here

# Face Liveness API Configuration
VITE_FACE_LIVENESS_URL=https://hackathon-face-liveness.e.gov.ph
VITE_FACE_LIVENESS_API_KEY=your_face_liveness_api_key

# eGovPH AI Integration API
VITE_EGOV_INTEGRATION_BASE_URL=https://egov-ai-core-ws.oueg.info
VITE_EGOV_ACCESS_CODE=your_access_code_here

# eGovPay Development Gateway
VITE_EGOVPAY_API_KEY=test_your_egovpay_api_key_here
VITE_EGOVPAY_SETTLEMENT_UUID=your_settlement_template_uuid_here
# Recipient-specific donation settlements. Campaigns without their own UUID are disabled.
# This must be a single-line JSON array. Example:
# VITE_DONATION_CAMPAIGNS_JSON=[{"id":"disaster-relief","title":"Disaster Relief","recipientName":"Verified Recipient","location":"Philippines","purpose":"Emergency relief","settlementTemplateUuid":"recipient_settlement_uuid","keywords":["disaster","relief","typhoon"],"suggestedAmounts":[100,500,1000],"active":true}]
VITE_DONATION_CAMPAIGNS_JSON=
# Test-only fee used by SSS Member Record Verification. The gateway rejects zero-value transactions.
VITE_SSS_RECORD_VERIFICATION_FEE=1

# DBM Transparency Portal (Compass API)
# Base URL: https://dbm-ws.oueg.info — proxied through /compass-api
# Used for live SAAODB, NCA, SARO, and LGSF budget records.
VITE_COMPASS_API_KEY=your_compass_api_key_here

# Environment
NODE_ENV=production
