# ============================================================================
# eGovpH Platform Integrations — Environment Configuration Template
# Copy this file to .env and fill in your assigned credentials.
# ===========================================================================

# Application Base URL
VITE_APP_BASE_URL=http://localhost:5173
VITE_USE_MOCK_SERVICES=false

# ----------------------------------------------------------------------------
# 1. eGov SSO (Single Sign-On & Citizen Profile)
# ----------------------------------------------------------------------------
VITE_EGOV_SSO_URL=https://platforms-api.e.gov.ph/egov-sso
VITE_EGOV_PARTNER_CODE=your_sso_partner_code_here
VITE_EGOV_PARTNER_SECRET=your_sso_partner_secret_here

# ----------------------------------------------------------------------------
# 2. eVerify & PhilSys Face Liveness Web SDK
# ----------------------------------------------------------------------------
VITE_EVERIFY_URL=https://platforms-api.e.gov.ph/everify
VITE_EVERIFY_CLIENT_ID=your_everify_client_id_here
VITE_EVERIFY_CLIENT_SECRET=your_everify_client_secret_here
VITE_EVERIFY_PUBKEY=your_everify_public_api_key_here

# ----------------------------------------------------------------------------
# 3. eMessage (SMS Push Notifications)
# ----------------------------------------------------------------------------
VITE_EMESSAGE_URL=https://platforms-api.e.gov.ph/emessage
VITE_EMESSAGE_TOKEN=your_emessage_token_here
VITE_EMESSAGE_ACCESS_TOKEN=your_emessage_token_here

# ----------------------------------------------------------------------------
# 4. eGovAI (AI Assistant, Speech Maker, Tourism, Laws, Translator)
# ----------------------------------------------------------------------------
VITE_EGOVAI_URL=https://platforms-api.e.gov.ph/egov-ai
VITE_EGOVAI_ACCESS_CODE=your_egovai_access_code_here
VITE_EGOV_ACCESS_CODE=your_egovai_access_code_here

# ----------------------------------------------------------------------------
# 5. eGovPay (Payment Gateway & Line Items)
# ----------------------------------------------------------------------------
VITE_EGOVPAY_URL=https://platforms-api.e.gov.ph/egovpay
VITE_EGOVPAY_TOKEN=your_egovpay_token_here
VITE_EGOVPAY_API_KEY=your_egovpay_token_here
VITE_EGOVPAY_SETTLEMENT_TEMPLATE_UUID=your_settlement_template_uuid_here
VITE_EGOVPAY_SETTLEMENT_UUID=your_settlement_template_uuid_here

# ----------------------------------------------------------------------------
# 6. eGovChain (Blockchain Transparency & Hash Proofs)
# ----------------------------------------------------------------------------
VITE_EGOVCHAIN_URL=https://platforms-api.e.gov.ph/egovchain
VITE_EGOVCHAIN_TOKEN=your_egovchain_token_here
# Optional Server-side node configuration for anchoring:
ECHAIN_RPC_URL=https://hackathon-blockchain.e.gov.ph
ECHAIN_EXPLORER_URL=https://hackathon-explorer.e.gov.ph
ECHAIN_CHAIN_ID=13371
ECHAIN_PRIVATE_KEY=your_32_byte_evm_private_key_here

# ----------------------------------------------------------------------------
# 7. eReport (Citizen Incident & LGU Reporting)
# ---------------------------------------------------------------------------
VITE_EREPORT_URL=https://platforms-api.e.gov.ph/ereport
VITE_EREPORT_ACCESS_CODE=your_ereport_access_code_here
VITE_EREPORT_ACCESS_TOKEN=your_ereport_access_code_here

# ----------------------------------------------------------------------------
# 8. Face Liveness REST API
# ----------------------------------------------------------------------------
VITE_FACELIVENESS_URL=https://platforms-api.e.gov.ph/face-liveness
VITE_FACELIVENESS_TOKEN=your_faceliveness_token_here
VITE_FACE_LIVENESS_API_KEY=your_faceliveness_token_here

# ----------------------------------------------------------------------------
# 9. Compass / DBM Transparency Portal
# ----------------------------------------------------------------------------
VITE_COMPASS_URL=https://platforms-api.e.gov.ph/compass
VITE_COMPASS_TOKEN=your_compass_token_here
VITE_COMPASS_API_KEY=your_compass_token_here
